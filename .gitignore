# Learn more https://docs.github.com/en/get-started/getting-started-with-git/ignoring-files

# --- JS / Node ---
node_modules/
npm-debug.*
yarn-debug.*
yarn-error.*
*.tsbuildinfo

# --- Expo / React Native ---
.expo/
dist/
web-build/
expo-env.d.ts
.metro-health-check*
# Generated native projects (Continuous Native Generation) — never commit or hand-edit.
apps/mobile/ios/
apps/mobile/android/
.kotlin/
*.orig.*

# Signing material. A leaked key cannot be rotated without a store resubmission.
*.jks
*.p8
*.p12
*.key
*.mobileprovision
*.pem

# --- Python ---
.venv/
venv/
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
coverage.xml
htmlcov/

# --- Terraform ---
.terraform/
*.tfstate
*.tfstate.*
# Variable files routinely hold project ids and secrets.
*.tfvars
!example.tfvars
.terraform.lock.hcl

# --- Secrets and local config ---
# Nothing holding a credential may be tracked (§18).
.env
.env.*
!.env.example
*-service-account.json
*-credentials.json
gha-creds-*.json

# --- Local data ---
*.sqlite
*.sqlite3
*.db

# --- Editors / OS ---
.DS_Store
Thumbs.db

example

# EAS Simulator session file — carries a daemon token.
.env.eas-simulator

# Local process logs from scripts/dev-stack.sh
.devlogs/

# Training and evaluation imagery. Large binaries, kept out of the app bundle
# and out of git history; copy them in from wherever they are kept.
datasets/

# Local object storage. Every photograph anybody uploaded to the dev
# stack lands here, and since data export shipped, so does a zip
# holding one person's entire account - wardrobe, conversations and
# all. 695 untracked files sat here with nothing stopping a
# `git add -A` from committing them.
services/api/.media/
.media/
