# Copy to .env and fill in what you have. Nothing here is a real credential.
# Every integration degrades to a labelled unavailable state rather than failing,
# so the app and API run with none of the optional values set.

# --- required: the API will not start without these -------------------------
DATABASE_URL=postgresql+asyncpg://atelier:atelier@localhost:55432/atelier
REDIS_URL=redis://localhost:55379/0
ENVIRONMENT=development

# --- Keycloak (ADR-016) -----------------------------------------------------
# No /auth prefix — it was removed in Keycloak 17.
KEYCLOAK_ISSUER=http://localhost:55080/realms/atelier
KEYCLOAK_CLIENT_ID=atelier-mobile
# Optional. Keycloak omits the requesting client from an access token's `aud`
# unless an Audience protocol mapper is configured, so audience checking is only
# enabled when this is set. Leave blank to skip it; `azp` is checked regardless.
KEYCLOAK_AUDIENCE=atelier-api
# Resolved by Keycloak at realm import; never a literal in version control.
ATELIER_API_CLIENT_SECRET=local-dev-only-not-a-real-secret

# --- Google, brokered through Keycloak --------------------------------------
# Until these are set the Google button appears but cannot complete.
GOOGLE_CLIENT_ID=unset
GOOGLE_CLIENT_SECRET=unset

# --- Meta Model API ---------------------------------------------------------
# Self-serve at https://dev.meta.ai/api-keys. Keys are prefixed LLM_.
# Rate limits are per TEAM, not per key — a second key buys no headroom.
# Without this the stylist reports `blocked`; nothing is simulated in its place.
MODEL_API_KEY=
META_BASE_URL=https://api.meta.ai/v1
META_TEXT_MODEL=muse-spark-1.3
META_REASONING_MODEL=muse-wonder-1.0
META_IMAGE_MODEL=muse-image-1.0
META_SEGMENTATION_MODEL=sam-3.1
META_TRANSCRIBE_MODEL=muse-voice-transcribe-1.0

# --- Object storage ---------------------------------------------------------
# Without a bucket, upload authorization reports storage_mode: "simulated".
GCS_BUCKET=
GCS_SIGNING_SERVICE_ACCOUNT=

# --- Sign in with ChatGPT (ADR-008) -----------------------------------------
# Commercial access is waitlist-gated, so this ships `unavailable`. Identity and
# plan-billed inference are separate permissions; image generation is never
# routed to the plan path in any state.
SIWC_CLIENT_ID=
SIWC_ENABLED=false

# --- Mobile, exposed in the bundle (EXPO_PUBLIC_*) --------------------------
# Only non-secret values belong here — anything EXPO_PUBLIC_ is readable in the
# shipped app. Rebranding is done entirely through these (ADR-002).
EXPO_PUBLIC_API_BASE_URL=http://localhost:8000
EXPO_PUBLIC_BRAND_NAME=
EXPO_PUBLIC_BRAND_TAGLINE=
EXPO_PUBLIC_WEB_ORIGIN=
EXPO_PUBLIC_SUPPORT_EMAIL=
