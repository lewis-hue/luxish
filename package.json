{
  "name": "fashion-ecosystem",
  "version": "0.1.0",
  "private": true,
  "description": "Mobile fashion discovery, wardrobe, styling, shopping and community ecosystem (working name: Atelier)",
  "license": "SEE LICENSE IN LICENSE",
  "workspaces": [
    "apps/mobile",
    "packages/*"
  ],
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "mobile": "npm run -w @fashion/mobile start",
    "mobile:android": "npm run -w @fashion/mobile android",
    "mobile:ios": "npm run -w @fashion/mobile ios",
    "mobile:web": "npm run -w @fashion/mobile web",
    "typecheck": "npm run -w @fashion/mobile typecheck",
    "lint": "npm run -w @fashion/mobile lint",
    "test": "npm run -w @fashion/mobile test",
    "contracts:generate": "npm run -w @fashion/contracts generate",
    "api": "cd services/api && uvicorn app.main:app --reload --port 8000",
    "api:test": "cd services/api && pytest -q",
    "api:migrate": "cd services/api && alembic upgrade head",
    "dev:up": "docker compose -f infra/docker-compose.yml up -d",
    "dev:down": "docker compose -f infra/docker-compose.yml down"
  }
}
