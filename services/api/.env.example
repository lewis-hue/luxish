# The API's local settings. Copy to `.env`; `review.sh` does that for you.
#
# Pydantic reads these with the prefix `LUXISH_`, so the field
# `meta_api_key` is `LUXISH_META_API_KEY` here. Every value below is a
# working local default except the model key, which is yours.

# SQLite locally: no container, no migrations race on first run, and a
# reviewer can delete one file to start over. Postgres is what deploys.
LUXISH_DATABASE_URL=sqlite+aiosqlite:///./luxish_dev.sqlite3

# Redis is the job broker. The port is high so it cannot collide with a
# Redis somebody already runs.
LUXISH_REDIS_URL=redis://127.0.0.1:55379/0

LUXISH_ENVIRONMENT=local

# **Optional, and the app is honest without it.**
#
# Enables the stylist, try-on, packshots and visual search. Left empty,
# those features report that they are unavailable rather than failing
# silently, and everything else works: Discover, search, the wardrobe,
# boards, messages and the seeded world.
LUXISH_META_API_KEY=

# Local object storage is simulated on disk under `.media/`. Nothing is
# uploaded anywhere.
LUXISH_GCS_BUCKET=luxish-local-simulated

# **Must match `KC_HOSTNAME` in `infra/.env` exactly.**
#
# Keycloak stamps this into the `iss` claim of every token, and the API
# checks it. If the two disagree, sign-in succeeds and then every single
# call returns 401 `bad_issuer` - which reads as a broken API rather than
# as a config mismatch, and costs an afternoon.
#
# `dev-stack.sh` rewrites this line with the machine's LAN address on
# every start, so it stays true when the network changes. Leave the
# placeholder; it is replaced before anything reads it.
LUXISH_KEYCLOAK_ISSUER=http://127.0.0.1:55080/realms/luxish
