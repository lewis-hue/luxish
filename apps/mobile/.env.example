# The Expo app's local settings. Copy to `.env`; `review.sh` does that
# for you.
#
# Only `EXPO_PUBLIC_*` variables reach the bundle. Nothing secret goes
# in this file: it is compiled into an app that ships to a phone.

# **The LAN address, not localhost.** The phone is a different machine;
# `localhost` there is the phone itself. `dev-stack.sh` rewrites both
# lines with this computer's address on every start, so they stay true
# when you move network. Leave the placeholders.
EXPO_PUBLIC_API_BASE_URL=http://127.0.0.1:8010

# Must match `LUXISH_KEYCLOAK_ISSUER` in `services/api/.env`. See the
# note there for what happens when they disagree.
EXPO_PUBLIC_KEYCLOAK_ISSUER=http://127.0.0.1:55080/realms/luxish

# The public client the app signs in with. PKCE, no secret.
EXPO_PUBLIC_KEYCLOAK_CLIENT_ID=luxish-mobile
