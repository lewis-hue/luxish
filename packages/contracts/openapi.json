that deleting a\ngarment always writes the media tombstones. Without them a categorisation\nor background-removal job already in flight would write its result back\nagainst an asset the user just deleted — the write guard consults the\ntombstone, not the garment row (ADR-012). There is one deletion path for\nexactly this reason.","operationId":"delete_garment_v1_wardrobe_garments__garment_id__delete","parameters":[{"name":"garment_id","in":"path","required":true,"schema":{"type":"string","format":"uuid","title":"Garment Id"}}],"responses":{"204":{"description":"Successful Response"},"422":{"description":"Validation Error","content":{"application/json":{"schema":{"$ref":"#/components/schemas/HTTPValidationError"}}}}}}},"/v1/wardrobe/garments/{garment_id}/favourite":{"post":{"tags":["wardrobe"],"summary":"Favourite","description":"Mark a garment as a favourite. Idempotent.\n\nA favourite is a **stated** preference, not an inferred one, so it is stored\nas user truth and the stylist weights it rather than guessing at it.","operationId":"favourite_v1_wardrobe_garments__garment_id__favourite_post","parameters":[{"name":"garment_id","in":"path","required":true,"schema":{"type":"string","format":"uuid","title":"Garment Id"}}],"responses":{"200":{"description":"Successful Response","content":{"application/json":{"schema":{"$ref":"#/components/schemas/GarmentMediaOut"}}}},"422":{"description":"Validation Error","content":{"application/json":{"schema":{"$ref":"#/components/schemas/HTTPValidationError"}}}}}},"delete":{"tags":["wardrobe"],"summary":"Unfavourite","description":"Un-favourite a garment. Idempotent, and returns the garment either way.","operationId":"unfavourite_v1_wardrobe_garments__garment_id__favourite_delete","parameters":[{"name":"garment_id","in":"path","required":true,"schema":{"type":"string","format":"uuid","title":"Garment Id"}}],"responses":{"200":{"description":"Successful Response","content":{"application/json":{"schema":{"$ref":"#/components/schemas/GarmentMediaOut"}}}},"422":{"description":"Validation Error","content":{"application/json":{"schema":{"$ref":"#/components/schemas/HTTPValidationError"}}}}}}},"/v1/wardrobe/favourites":{"get":{"tags":["wardrobe"],"summary":"Read Favourites","description":"This user's favourites, newest first. Same cursor idiom as the wardrobe.","operationId":"read_favourites_v1_wardrobe_favourites_get","parameters":[{"name":"cursor","in":"query","required":false,"schema":{"anyOf":[{"type":"string"},{"type":"null"}],"title":"Cursor"}},{"name":"limit","in":"query","required":false,"schema":{"type":"integer","maximum":200,"minimum":1,"default":50,"title":"Limit"}}],"responses":{"200":{"description":"Successful Response","content":{"application/json":{"schema":{"$ref":"#/components/schemas/FavouritePage"}}}},"422":{"description":"Validation Error","content":{"application/json":{"schema":{"$ref":"#/components/schemas/HTTPValidationError"}}}}}}},"/v1/wardrobe/favourites/ids":{"get":{"tags":["wardrobe"],"summary":"Read Favourite Ids","description":"Just the ids — the cheap read the stylist's retrieval step wants.","operationId":"read_favourite_ids_v1_wardrobe_favourites_ids_get","responses":{"200":{"description":"Successful Response","content":{"application/json":{"schema":{"$ref":"#/components/schemas/FavouriteIdsOut"}}}}}}},"/v1/wardrobe/garments/bulk":{"post":{"tags":["wardrobe"],"summary":"Bulk Create","description":"Create many garments from already-authorised uploads.\n\n**200 even when some items fail.** A partial failure is reported per item,\nnever as a status code: nineteen good photographs must not be discarded\nbecause the twentieth referenced an upload that is not this user's. Each\nitem is independently durable and independently idempotent on its\n``media_asset_id``.","operationId":"bulk_create_v1_wardrobe_garments_bulk_post","requestBody":{"content":{"application/json":{"schema":{"$ref":"#/components/schemas/BulkGarmentCreate"}}},"required":true},"responses":{"200":{"descript