,"required":["items","succeeded","failed"],"title":"BulkResultOut","description":"A batch result. **Never** a 4xx for a partial failure.\n\nOne bad item out of twenty must not discard the nineteen that worked, so the\nresponse is a 200 (or 207-shaped 200) carrying per-item status, and the\ncounts are precomputed because every client needs them."},"FavouriteIdsOut":{"properties":{"garment_ids":{"items":{"type":"string","format":"uuid"},"type":"array","title":"Garment Ids"},"total":{"type":"integer","title":"Total"},"truncated":{"type":"boolean","title":"Truncated","default":false}},"type":"object","required":["garment_ids","total"],"title":"FavouriteIdsOut","description":"Just the ids, for a client — or the stylist — that weights favourites.\n\n``total`` is reported separately so a truncated read is visible rather than\nsilently partial."},"FavouritePage":{"properties":{"items":{"items":{"$ref":"#/components/schemas/GarmentMediaOut"},"type":"array","title":"Items"},"next_cursor":{"anyOf":[{"type":"string"},{"type":"null"}],"title":"Next Cursor"}},"type":"object","required":["items"],"title":"FavouritePage"},"FeedbackCreate":{"properties":{"kind":{"type":"string","enum":["would_wear","wore","dislike"],"title":"Kind"},"note":{"anyOf":[{"type":"string","maxLength":500},{"type":"null"}],"title":"Note"}},"additionalProperties":false,"type":"object","required":["kind"],"title":"FeedbackCreate"},"FeedbackOut":{"properties":{"id":{"type":"string","format":"uuid","title":"Id"},"outfit_id":{"type":"string","format":"uuid","title":"Outfit Id"},"kind":{"type":"string","enum":["would_wear","wore","dislike"],"title":"Kind"},"note":{"anyOf":[{"type":"string"},{"type":"null"}],"title":"Note"}},"type":"object","required":["id","outfit_id","kind"],"title":"FeedbackOut"},"GarmentCreate":{"properties":{"name":{"anyOf":[{"type":"string","maxLength":160},{"type":"null"}],"title":"Name"},"category":{"anyOf":[{"type":"string","maxLength":64},{"type":"null"}],"title":"Category"},"media_asset