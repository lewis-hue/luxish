}},"/v1/auth/backchannel-logout":{"post":{"tags":["auth"],"summary":"Backchannel Logout","description":"OIDC back-channel logout.\n\nUnauthenticated by design — the logout token *is* the authentication, and it\nis verified exactly like an access token plus the required logout event.","operationId":"backchannel_logout_v1_auth_backchannel_logout_post","responses":{"204":{"description":"Successful Response"}}}},"/v1/uploads/authorize":{"post":{"tags":["uploads"],"summary":"Authorize","description":"Authorise one upload: short-lived, capped, and owner-bound.","operationId":"authorize_v1_uploads_authorize_post","requestBody":{"content":{"application/json":{"schema":{"$ref":"#/components/schemas/UploadAuthorizeRequest"}}},"required":true},"responses":{"201":{"description":"Successful Response","content":{"application/json":{"schema":{"$ref":"#/components/schemas/UploadAuthorizeResponse"}}}},"422":{"description":"Validation Error","content":{"application/json":{"schema":{"$ref":"#/components/schemas/HTTPValidationError"}}}}}}},"/v1/wardrobe/garments":{"get":{"tags":["wardrobe"],"summary":"List Garments","operationId":"list_garments_v1_wardrobe_garments_get","parameters":[{"name":"cursor","in":"query","required":false,"schema":{"anyOf":[{"type":"string"},{"type":"null"}],"title":"Cursor"}},{"name":"category","in":"query","required":false,"schema":{"anyOf":[{"type":"string","maxLength":64},{"type":"null"}],"title":"Category"}},{"name":"availability","in":"query","required":false,"schema":{"anyOf":[{"type":"string","maxLength":32},{"type":"null"}],"title":"Availability"}},{"name":"limit","in":"query","required":false,"schema":{"type":"integer","maximum":200,"minimum":1,"default":50,"title":"Limit"}}],"responses":{"200":{"description":"Successful Response","content":{"application/json":{"schema":{"$ref":"#/components/schemas/GarmentPage"}}}},"422":{"description":"Validation Error","content":{"application/json":{"schema":{"$ref":"#/components/schemas/HTTPValidationError"}}}}}},