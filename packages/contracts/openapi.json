    "/v1/auth/session": {
      "post": {
        "tags": [
          "auth"
        ],
        "summary": "Create Session",
        "description": "Exchange a verified Keycloak token for local session state.\n\nIdempotent: presenting a token for an already-provisioned ``sub`` returns\nthe same user. The response carries no credential \u2014 the client already holds\nthe only one that exists.",
        "operationId": "create_session_v1_auth_session_post",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SessionResponse"
                }
              }
            }
          }
        }
      },
      "delete": {
        "tags": [
          "auth"
        ],
        "summary": "Delete Session",
        "operationId": "delete_session_v1_auth_session_delete",
        "responses": {
          "204": {
            "description": "Successful Response"
          }
        }
      }
    },
