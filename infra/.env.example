# Container settings for the local stack. Copy to `.env`; `review.sh`
# does that for you.

# **The origin Keycloak advertises in every token.** Must match
# `LUXISH_KEYCLOAK_ISSUER` in `services/api/.env` apart from the realm
# path. `dev-stack.sh` rewrites this with the machine's LAN address on
# every start, so the phone can reach it. Leave the placeholder.
KC_HOSTNAME=http://127.0.0.1:55080

# Keycloak's own admin console, at http://localhost:55080. Local only.
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin

# Postgres for the local stack.
POSTGRES_USER=luxish
POSTGRES_PASSWORD=luxish
POSTGRES_DB=luxish

# **Optional: sign in with Google.**
#
# Email and password work without these. Fill them in only if you want
# to exercise the Google path, and never commit the result.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
