# Local development secrets for the Keycloak realm import.
#
# Copy to `infra/.env` and fill in. That file is gitignored; this one is not,
# so it must never contain a real value.
#
# Google OAuth credentials come from the Google Cloud console under
# APIs & Services > Credentials > OAuth 2.0 Client IDs, for a "Web application"
# client. The client must list this exact authorised redirect URI, or Google
# returns redirect_uri_mismatch:
#
#   http://localhost:55080/realms/luxish/broker/google/endpoint
#
# The port is 55080 because the stack deliberately uses high ports to avoid
# colliding with anything already on 8080.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
